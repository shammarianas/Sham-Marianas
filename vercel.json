{
  "version": 2,
  "buildCommand": "npm run build:production",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sitemap-index.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=3600"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/category/:path*",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/templates",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/demo",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/services/brandingpage",
      "destination": "/services/uiux-design",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "shammarianas.com" }],
      "destination": "https://www.shammarianas.com/$1",
      "permanent": true
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
