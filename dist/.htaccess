# SPA routing for React (Vite) on Apache/cPanel
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Keep one HTTPS www host for all public URLs.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^shammarianas\.com$ [NC]
  RewriteRule ^ https://www.shammarianas.com%{REQUEST_URI} [R=301,L]

  # Retire the old digital-asset marketplace URLs.
  RewriteRule ^category(?:/.*)?$ /services [R=301,L,NC]
  RewriteRule ^templates/?$ /services [R=301,L,NC]
  RewriteRule ^services/demo/?$ /services [R=301,L,NC]
  RewriteRule ^services/brandingpage/?$ /services/uiux-design [R=301,L,NC]
  RewriteRule ^blogs/?$ /blog [R=301,L,NC]
  RewriteRule ^blog-details/(.+)/?$ /blog/$1 [R=301,L,NE]

  # Allow existing files and directories to be served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # Otherwise, serve index.html so client-side router can handle it
  RewriteRule ^ index.html [L]
</IfModule>

# Keep crawler-control files fresh enough for SEO updates.
<IfModule mod_headers.c>
  <FilesMatch "^(robots\.txt|sitemap(?:-index)?\.xml)$">
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
    Header always set CDN-Cache-Control "public, max-age=3600"
    Header always set Cloudflare-CDN-Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# Cache static assets (optional)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
